#!/bin/sh
set -e

name=sg
bin="$HOME/Documents/bin"
receipts="$HOME/Documents/.pkg"
catalog=${PKG_SERVER:-https://raw.githubusercontent.com/holzschu/a-Shell-commands/master}
# PKG_SERVER selects the catalog; an asset mirror is independent.
assets=${PKG_ASSET_SERVER:-https://github.com/holzschu/a-Shell-commands/releases/download/0.1}
guest_sha256=4ea79cf338f15e1eacc93dd9583ac61c1684b935fd41d393bcf4a75afb7e6405
uninstall_sha256=7169b397b8ab6f53c03cd2d89a96d08f07a35f61e396a98616c64b34d40a4d42

matches() {
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    digest=$(sha256 "$1") || return 1
    [ "${digest##* }" = "$2" ]
}

if [ -x "$bin/$name" ] && matches "$bin/$name" "$guest_sha256" &&
    matches "$receipts/$name" "$uninstall_sha256"; then
    echo "$name is already installed"
    exit 0
fi
for path in "$receipts/$name" "$bin/$name"; do
    if [ -e "$path" ] || [ -L "$path" ]; then
        echo "$name: refusing to replace $path; remove it before reinstalling" >&2
        exit 1
    fi
done

echo "Installing $name"
mkdir -p "$bin" "$receipts"
stage="$HOME/tmp/$name.download.$$"
while [ -e "$stage" ] || [ -L "$stage" ]; do
    stage="$stage.next"
done
mkdir "$stage"
trap 'rm -f "$stage/guest" "$stage/uninstall"; rmdir "$stage"' 0
trap 'exit 1' HUP INT TERM

curl -fLSs "${assets%/}/$name" -o "$stage/guest"
if ! matches "$stage/guest" "$guest_sha256"; then
    echo "$name: WASM SHA-256 mismatch" >&2
    exit 1
fi
curl -fLSs "${catalog%/}/uninstall/$name" -o "$stage/uninstall"
if ! matches "$stage/uninstall" "$uninstall_sha256"; then
    echo "$name: uninstall script SHA-256 mismatch" >&2
    exit 1
fi
chmod +x "$stage/guest"
# If publication is interrupted, pkg remove can clean up the partial install.
mv "$stage/uninstall" "$receipts/$name"
mv "$stage/guest" "$bin/$name"
